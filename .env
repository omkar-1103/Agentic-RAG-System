# LLM API Keys
GOOGLE_API_KEY=

# Tool API Keys
TAVILY_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=y

# Database Configuration (CockroachDB uses PostgreSQL drivers)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<cluster_name>.<database_name>?sslmode=verify-full
DATABASE_URL=

# LangSmith Tracing (Optional but highly recommended for LangGraph)
LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_PROJECT=
